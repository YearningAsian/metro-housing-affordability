# Copy to .env and fill in. Never commit .env.
CENSUS_API_KEY=
FRED_API_KEY=
HUD_API_TOKEN=

# Cloudflare R2 bucket that keeps the pipeline state (README: Monthly pipeline). Only push-state and pull-state use these.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
